# Copie para .env e preencha
DATABASE_URL=postgresql+psycopg://compras:compras@localhost:5432/compras

# Provedor de visão: claude | gemini | openai | lmstudio
PROVEDOR_VISAO=lmstudio

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Modelos (ajuste para as versões atuais de cada provedor)
